# Copy to .env for local development. Never commit real values.
# Production and sandbox secrets live in the hosting provider's secret store, not in files.

# local | test | sandbox | production
APP_ENV=local
LOG_LEVEL=info

# Database — local Postgres. Sandbox/production use separate projects and credentials.
DATABASE_URL=postgres://th:th@localhost:5432/transferhub_dev
TEST_DATABASE_URL=postgres://th:th@localhost:5432/transferhub_test

# API
API_PORT=4000
# Comma-separated origins allowed to call the API from a browser.
WEB_ORIGINS=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_CONCURRENCY=4

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
