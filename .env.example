# Copy to .env; run npm run setup:env to generate a local diagnostic token.
NODE_ENV=development
PLATFORM_MODE=sandbox
DATABASE_URL=postgresql://transferhub:local-only-change-me@127.0.0.1:5432/transferhub
DATABASE_SSL=false
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
DIAGNOSTICS_TOKEN=replace-with-at-least-32-random-characters
WORKER_POLL_MS=1000
WORKER_LEASE_SECONDS=30
