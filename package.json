{
  "name": "transferhub",
  "private": true,
  "description": "TransferHub — customer, workflow, ledger and reconciliation platform for partner-operated financial services. Proprietary to Transparent Transfers Technology.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter @transferhub/api --filter @transferhub/worker run build && pnpm --filter @transferhub/web run build",
    "build:libs": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @transferhub/db run migrate",
    "db:status": "pnpm --filter @transferhub/db run status",
    "db:seed": "pnpm --filter @transferhub/core run seed",
    "dev:api": "pnpm --filter @transferhub/api run dev",
    "dev:worker": "pnpm --filter @transferhub/worker run dev",
    "dev:web": "pnpm --filter @transferhub/web run dev",
    "check": "pnpm format:check && pnpm lint && pnpm build:libs && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
