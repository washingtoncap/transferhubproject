{
  "name": "transferhub-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api,worker \"npm run dev -w @transferhub/web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file=.env --import tsx apps/worker/src/main.ts",
    "build": "npm run build:server && npm run build -w @transferhub/web",
    "build:server": "tsc -p tsconfig.server.json",
    "start:api": "node --env-file=.env dist/apps/api/src/main.js",
    "start:worker": "node --env-file=.env dist/apps/worker/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && npm run typecheck -w @transferhub/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "job:enqueue": "node --env-file=.env --import tsx scripts/enqueue.ts",
    "openapi:generate": "node --import tsx scripts/openapi.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "test:postgres": "node --env-file-if-exists=.env --import tsx --test tests/postgres.integration.ts",
    "demo:embedded": "node --env-file=.env --import tsx scripts/demo-embedded.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "helmet": "8.3.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "type": "module"
}
